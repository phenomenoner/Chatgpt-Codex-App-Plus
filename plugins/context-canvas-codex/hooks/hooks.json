{
  "description": "Optional Context Canvas task-map binding plus explicitly requested PostToolUse snapshots.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/context_canvas.py\" hook-session-start",
            "commandWindows": "python -I \"$env:PLUGIN_ROOT\\scripts\\context_canvas.py\" hook-session-start",
            "timeout": 10,
            "statusMessage": "Restoring optional Context Canvas map",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/context_canvas.py\" hook-user-prompt-submit",
            "commandWindows": "python -I \"$env:PLUGIN_ROOT\\scripts\\context_canvas.py\" hook-user-prompt-submit",
            "timeout": 10,
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/context_canvas.py\" hook-post-tool-use",
            "commandWindows": "python -I \"$env:PLUGIN_ROOT\\scripts\\context_canvas.py\" hook-post-tool-use",
            "timeout": 30,
            "statusMessage": "Checking explicit Canvas capture request"
          }
        ]
      }
    ]
  }
}
