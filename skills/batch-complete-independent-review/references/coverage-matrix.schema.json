{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-review-coverage-matrix.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cells"],
  "properties": {
    "schemaVersion": {"const": "batch-review-coverage-matrix.v1"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cellId",
          "contractId",
          "lifecyclePhase",
          "variant",
          "required",
          "requiredTier"
        ],
        "properties": {
          "cellId": {"type": "string", "minLength": 1},
          "contractId": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string"},
          "operation": {"type": "string"},
          "lifecyclePhase": {"type": "string", "minLength": 1},
          "variant": {"type": "string", "minLength": 1},
          "expectedBehavior": {"type": "string"},
          "required": {"type": "boolean"},
          "requiredTier": {"enum": ["T0", "T1", "T2", "T3", "T4"]}
        }
      }
    }
  }
}
