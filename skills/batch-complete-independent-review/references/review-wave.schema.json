{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-review-wave.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "reviewWaveId",
    "candidateManifest",
    "evidenceIndex",
    "reviewPlan",
    "coverageMatrix"
  ],
  "properties": {
    "schemaVersion": {"const": "batch-review-wave.v1"},
    "protocolVersion": {"const": "batch-complete-independent-review/v1"},
    "reviewWaveId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateManifest": {"$ref": "#/$defs/artifact"},
    "evidenceIndex": {"$ref": "#/$defs/artifact"},
    "reviewPlan": {"$ref": "#/$defs/artifact"},
    "coverageMatrix": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
