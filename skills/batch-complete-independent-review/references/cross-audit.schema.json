{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-review-cross-audit.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditMode",
    "binding",
    "auditor",
    "peerContinuedAfterFirstBlocker",
    "peerFixedPointStable",
    "coverageChallenges",
    "findingChallenges",
    "newFindings",
    "duplicateClusters",
    "unresolvedChallengeIds",
    "recommendation",
    "recommendationRationale"
  ],
  "properties": {
    "schemaVersion": {"const": "batch-review-cross-audit.v1"},
    "auditMode": {"enum": ["NARROW", "RECIPROCAL"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewWaveId",
        "ownReportSha256",
        "peerReportSha256"
      ],
      "properties": {
        "reviewWaveId": {"$ref": "#/$defs/sha256"},
        "ownReportSha256": {"$ref": "#/$defs/sha256"},
        "peerReportSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "independentPass"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "independentPass": {"const": true}
      }
    },
    "peerContinuedAfterFirstBlocker": {"type": "boolean"},
    "peerFixedPointStable": {"type": "boolean"},
    "coverageChallenges": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverageChallenge"}
    },
    "findingChallenges": {
      "type": "array",
      "items": {"$ref": "#/$defs/findingChallenge"}
    },
    "newFindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/newFinding"}
    },
    "duplicateClusters": {
      "type": "array",
      "items": {"$ref": "#/$defs/duplicateCluster"}
    },
    "unresolvedChallengeIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "recommendation": {
      "enum": ["READY_FOR_SYNTHESIS", "THIRD_REVIEW_REQUIRED", "INCOMPLETE"]
    },
    "recommendationRationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "locator", "claim", "tier"],
      "properties": {
        "kind": {
          "enum": ["SOURCE", "CONTRACT", "TEST", "RECEIPT", "MANIFEST"]
        },
        "path": {"type": "string"},
        "locator": {"type": "string"},
        "claim": {"type": "string"},
        "tier": {"enum": ["T0", "T1", "T2", "T3", "T4"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverageChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "cellIds",
        "challenge",
        "evidence",
        "disposition",
        "requiredSynthesisAction"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "UNSUPPORTED_CLOSURE",
            "WRONG_TIER",
            "MISSED_SIBLING",
            "INCOMPLETE_REPAIR_POSTCONDITION",
            "UNSTABLE_FIXED_POINT",
            "HASH_OR_BINDING_FAILURE"
          ]
        },
        "cellIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "challenge": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "disposition": {
          "enum": ["SUPPORTED_BY_UNION", "REJECTED_WITH_EVIDENCE", "UNRESOLVED"]
        },
        "requiredSynthesisAction": {"type": "string", "minLength": 1}
      }
    },
    "findingChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "findingIds",
        "assessment",
        "challenge",
        "evidence",
        "disposition"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "findingIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "assessment": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "SEVERITY_CHALLENGE",
            "MISSED_SIBLING",
            "INCOMPLETE_REPAIR_POSTCONDITION",
            "DUPLICATE"
          ]
        },
        "challenge": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "disposition": {
          "enum": ["SUPPORTED_BY_UNION", "REJECTED_WITH_EVIDENCE", "UNRESOLVED"]
        }
      }
    },
    "newFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "blocking",
        "summary",
        "contractIds",
        "cellIds",
        "preconditions",
        "executionPath",
        "firstUnsafeOperation",
        "impact",
        "evidence",
        "requiredRepairProperties",
        "requiredRegressionCellIds"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "blocking": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1},
        "contractIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "cellIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "executionPath": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "firstUnsafeOperation": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "requiredRepairProperties": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "requiredRegressionCellIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "duplicateCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "findingIds", "relationship", "synthesisRule"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "findingIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "relationship": {
          "enum": [
            "FULL_DUPLICATE_PRIMITIVE",
            "PARTIAL_OVERLAP_RETAIN_DISTINCT_AXES",
            "RELATED_FAMILY_NOT_DUPLICATE",
            "UNIQUE"
          ]
        },
        "synthesisRule": {"type": "string", "minLength": 1}
      }
    }
  }
}
